on post-fs-data
    mkdir /data/vendor/floral 0711 root root
    mkdir /data/vendor/floral/radio 0770 radio radio
    restorecon_recursive /data/vendor/floral/radio

    # Keep the mounted identity private while allowing the radio service to read it.
    chown radio radio /ipc/floral_stream/radio.json
    chmod 0600 /ipc/floral_stream/radio.json

service vendor.floral-rild /vendor/bin/hw/floral-rild
    class main
    user radio
    group radio cache inet misc audio log readproc wakelock
    capabilities BLOCK_SUSPEND NET_ADMIN NET_RAW
    interface android.hardware.radio@1.0::IRadio slot1
    interface android.hardware.radio@1.1::IRadio slot1
    interface android.hardware.radio@1.2::IRadio slot1
    interface android.hardware.radio@1.3::IRadio slot1
    interface android.hardware.radio@1.4::IRadio slot1
    interface android.hardware.radio@1.5::IRadio slot1
    interface android.hardware.radio@1.6::IRadio slot1
    interface android.hardware.radio.config@1.0::IRadioConfig default
    interface android.hardware.radio.config@1.1::IRadioConfig default
    interface android.hardware.radio.config@1.3::IRadioConfig default
    interface aidl floral.device.radio.IRadioState/default
